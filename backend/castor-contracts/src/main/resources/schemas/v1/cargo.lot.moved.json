{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castor.djavafactory.com/schemas/v1/cargo.lot.moved.json",
  "title": "cargo.lot.moved",
  "type": "object",
  "required": ["lotId", "fromId", "toId", "quantity", "unit"],
  "properties": {
    "lotId": { "type": "string", "minLength": 1 },
    "fromId": { "type": "string", "minLength": 1 },
    "toId": { "type": "string", "minLength": 1 },
    "quantity": { "type": "number", "exclusiveMinimum": 0 },
    "unit": { "enum": ["TONNES", "PIECES", "CUBIC_METRES"] },
    "handledBy": { "type": "string", "minLength": 1 }
  }
}
