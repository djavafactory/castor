{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castor.djavafactory.com/schemas/v1/gate.transaction.json",
  "title": "gate.transaction",
  "type": "object",
  "required": ["truckVisitId", "gateId", "direction"],
