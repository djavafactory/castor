# Copy to .env (git-ignored). Placeholders only: never commit real values.
CASTOR_ENV=local                     # local | dev | test (staging and prod come later)
POSTGRES_DB=castor
POSTGRES_USER=castor
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
LOCAL_DB_PORT=5432
DEV_WEB_PORT=8080
DEV_GATEWAY_PORT=8082                # host port (127.0.0.1 only) of castor-dev-gateway
DB_URL=jdbc:postgresql://localhost:5432/castor
DB_USERNAME=castor_app
DB_PASSWORD=castor_app_dev           # local/dev role password from db/init/01-roles.sql
DB_FLYWAY_USERNAME=castor_flyway
DB_FLYWAY_PASSWORD=castor_flyway_dev
DB_GATEWAY_USERNAME=castor_gateway
DB_GATEWAY_PASSWORD=castor_gateway_dev   # local/dev role password from db/init/01-roles.sql
CASTOR_ADMIN_USERNAME=admin
CASTOR_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_14_CHARS
CASTOR_DEMO_LOGIN=true               # demo users + "Sign in as" list; local and dev only
CASTOR_RESET_ON_START=false          # true only in dev (set by compose)
CASTOR_CORS_ORIGINS=http://localhost:5173
CASTOR_PORT_CODE=westports
LOCAL_KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092   # local backend; compose sets castor-dev-kafka:9092 in dev
CASTOR_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN   # shared secret of every internal API between core, gateway and emulator
GATEWAY_DEMO_KEY=CHANGE_ME_GATEWAY_KEY   # API key (X-Castor-Key) of every source of the local and dev gateway; CI replaces it
