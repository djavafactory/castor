# Copy to .env.local. Only VITE_* values reach the browser bundle: never put secrets here. PORT is read by Vite only.
PORT=5173
VITE_APP_ENV=local
VITE_API_URL=http://localhost:8081/api
VITE_PORT_CODE=westports
VITE_DEMO_LOGIN=true
VITE_SATELLITE_TILE_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2024_3857/default/g/{z}/{y}/{x}.jpg
# Read by Playwright against a running environment (not bundled)
E2E_BASE_URL=http://localhost:8080
E2E_USERNAME=admin
E2E_PASSWORD=CHANGE_ME_AT_LEAST_14_CHARS
