{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castor.djavafactory.com/schemas/v1/storage.level.observed.json",
  "title": "storage.level.observed",
  "type": "object",
  "required": ["storageId", "commodity", "quantity", "unit"],
  "properties": {
    "storageId": { "type": "string", "minLength": 1 },
    "commodity": { "type": "string", "minLength": 1 },
    "quantity": { "type": "number", "minimum": 0 },
    "unit": { "enum": ["TONNES", "PIECES", "CUBIC_METRES"] },
    "temperatureC": { "type": "number", "minimum": -273.15 },
    "densityKgM3": { "type": "number", "exclusiveMinimum": 0 }
  }
}
